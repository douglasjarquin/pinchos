---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  docs?: boolean;
  recipes?: boolean;
  noindex?: boolean;
}

const { title, description, docs = false, recipes = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const siteUrl = new URL(base, 'https://douglasjarquin.github.io').href;
const github = 'https://github.com/douglasjarquin/pinchos';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'pinchos',
      url: siteUrl,
      description: 'pinchos runs your commands and pins their output to the macOS menu bar.',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'pinchos',
      url: siteUrl,
      description: 'pinchos runs the commands you give it and keeps their output close at hand.',
      applicationCategory: 'macOS menu bar utility',
      operatingSystem: 'macOS',
      isAccessibleForFree: true,
      sameAs: [github],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600&display=swap" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="site-shell">
      <SiteHeader docs={docs} recipes={recipes} />
      <main><slot /></main>
      <SiteFooter />
    </div>
  </body>
</html>
