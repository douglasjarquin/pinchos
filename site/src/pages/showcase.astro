---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Mark from '../components/Mark.astro';
import ProductMockup from '../components/ProductMockup.astro';
---

<BaseLayout title="pinchos primitives" description="The reusable primitives behind the pinchos web design system.">
  <div class="showcase container container--docs">
    <header class="showcase__intro">
      <div class="overline">primitive showcase</div>
      <h1 class="serif-heading">The pieces before the pages.</h1>
      <p class="body-copy">A small, static reference surface for the components shared by the landing and design-system pages.</p>
    </header>

    <section class="showcase__grid" aria-label="Primitive examples">
      <article class="raised-card showcase__card">
        <div class="overline">mark and wordmark</div>
        <div class="showcase__lockup"><Mark size={30} label="pinchos mark" /><span>pinchos</span></div>
        <p class="meta-copy">Fixed brand colors, lowercase wordmark, and no decorative motion.</p>
      </article>
      <article class="raised-card showcase__card">
        <div class="overline">buttons and links</div>
        <div class="showcase__actions">
          <Button href="#primary">Primary <span aria-hidden="true">→</span></Button>
          <Button href="#secondary" variant="secondary">Secondary</Button>
          <a class="text-link" href="#text">Text link</a>
        </div>
        <p class="meta-copy">Hover, active, and focus styles are carried by native anchors.</p>
      </article>
      <article class="raised-card showcase__card">
        <div class="overline">code</div>
        <CodeBlock lines={['swift build -c release']} />
        <p class="meta-copy">Charcoal, ivory text, and a terracotta shell prompt.</p>
      </article>
      <article class="raised-card showcase__card showcase__card--wide">
        <div class="overline">product mockup</div>
        <ProductMockup compact />
        <p class="meta-copy">The dark product surface is real text and layout, not a screenshot.</p>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .showcase {
    padding-block: var(--space-16) var(--space-24);
  }

  .showcase__intro {
    display: flex;
    max-width: 620px;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-18);
  }

  .showcase__intro h1 {
    font-size: clamp(2.5rem, 6vw, 3.375rem);
    line-height: 1.06;
    letter-spacing: -0.015em;
  }

  .showcase__intro p {
    max-width: 50ch;
    margin: 0;
  }

  .showcase__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .showcase__card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
  }

  .showcase__card--wide {
    grid-column: 1 / -1;
  }

  .showcase__lockup {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .showcase__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .showcase__card .code-block {
    padding: var(--space-3) var(--space-4);
  }

  .meta-copy {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 12.5px;
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .showcase {
      padding-block: var(--space-12) var(--space-18);
    }

    .showcase__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
