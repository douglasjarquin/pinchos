---
interface Props {
  size?: number;
  label?: string;
}

const { size = 22, label } = Astro.props;
const stroke = size >= 48 ? 2.3 : size >= 30 ? 2.4 : 2.7;
const radius = size >= 48 ? 3 : size >= 30 ? 3.1 : 3.3;
---

<svg
  class="mark"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <line x1="8.5" y1="26" x2="8.5" y2="14" stroke="var(--color-ink)" stroke-width={stroke} stroke-linecap="round" />
  <circle cx="8.5" cy="11.6" r={radius} fill="var(--color-olive)" />
  <line x1="16" y1="26" x2="16" y2="9.5" stroke="var(--color-ink)" stroke-width={stroke} stroke-linecap="round" />
  <circle cx="16" cy="6.9" r={radius} fill="var(--color-terracotta)" />
  <line x1="23.5" y1="26" x2="23.5" y2="16.5" stroke="var(--color-ink)" stroke-width={stroke} stroke-linecap="round" />
  <circle cx="23.5" cy="14.1" r={radius} fill="var(--color-olive)" />
</svg>
