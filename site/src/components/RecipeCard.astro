---
import type { Recipe } from '../data/recipe-catalog';

interface Props {
  readonly recipe: Recipe;
}

const { recipe } = Astro.props;
const titleId = `recipe-${recipe.slug}-title`;
const previewLabel = recipe.items.length === 1 ? 'menu bar item' : 'menu bar items';
---

<article class="recipe-card raised-card" data-recipe-card data-search-text={recipe.searchText} aria-labelledby={titleId}>
  <header class="recipe-card__header">
    <div>
      <div class="overline">{recipe.category}</div>
      <h2 id={titleId} class="serif-heading">{recipe.title}</h2>
    </div>
    <code>{recipe.filename}</code>
  </header>

  <div class="recipe-card__columns">
    <section class="recipe-card__source" aria-labelledby={`${titleId}-source`}>
      <h3 id={`${titleId}-source`} class="overline">TOML</h3>
      <pre><code>{recipe.source}</code></pre>
    </section>

    <section class="recipe-card__preview" aria-labelledby={`${titleId}-preview`}>
      <h3 id={`${titleId}-preview`} class="overline">Theoretical {previewLabel}</h3>
      <div class="recipe-preview__bar" aria-label={`Theoretical menu bar preview for ${recipe.title}`}>
        {recipe.items.map((item) => (
          <span class="recipe-preview__item">
            <span class="recipe-preview__name">{item.name}</span>
            <span>{item.preview}</span>
          </span>
        ))}
      </div>
      <dl class="recipe-preview__details">
        {recipe.items.map((item) => (
          <div>
            <dt>{item.name}</dt>
            <dd>{item.interval} · {item.format}</dd>
          </div>
        ))}
      </dl>
      <p class="recipe-preview__note">Copy the item table into your config, replace placeholders, then validate before running it.</p>
    </section>
  </div>
</article>
