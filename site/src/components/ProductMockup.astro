---
import sampleConfig from '../../../example/pinchos.toml?raw';
import InteractiveMenuBar from './InteractiveMenuBar.astro';

interface Props {
  compact?: boolean;
  interactive?: boolean;
}

const { compact = false, interactive = false } = Astro.props;
---

<figure class:list={['product-figure', { 'product-figure--compact': compact }]}>
  <div class="product-visual">
    {interactive ? (
      <InteractiveMenuBar />
    ) : (
      <>
        <div class="menu-bar" role="group" aria-label="Example menu bar with a failed deploy item">
          <span>disk 82%</span>
          <span>vpn up</span>
          <span class="menu-bar__warning">deploy ⚠︎</span>
          <span>14:32</span>
        </div>
        <div class="failure-menu" role="group" aria-label="Example pinchos failure menu">
          <div class="failure-menu__row">Run Deploy Check</div>
          <div class="failure-menu__row">Refresh Now</div>
          <div class="menu-rule"></div>
          <div class="failure-menu__row failure-menu__row--strong">Failed 2 minutes ago — exit 1</div>
          <div class="failure-menu__error">jq: parse error: Invalid numeric literal</div>
          <div class="failure-menu__row">Copy Full Error</div>
          <div class="menu-rule"></div>
          <div class="failure-menu__row failure-menu__row--between"><span>Diagnostics</span><span>▸</span></div>
        </div>
      </>
    )}
    {!compact && (
      <details class="config-disclosure">
        <summary aria-controls="sample-pinchos-config">
          <span>See config</span>
          <span class="config-disclosure__indicator" aria-hidden="true">+</span>
        </summary>
        <div class="config-panel" id="sample-pinchos-config" role="region" aria-label="Sample pinchos.toml configuration">
          <pre tabindex="0"><code>{sampleConfig}</code></pre>
        </div>
      </details>
    )}
  </div>
  {!compact && (
    <figcaption>
      {interactive
        ? 'click an item to open its submenu; Option-click an item to reveal diagnostics.'
        : 'a failing item promotes its cause to the first level — one glance, one Copy Full Error.'}
    </figcaption>
  )}
</figure>

<style>
  .product-figure {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    margin: 0;
  }

  .product-visual {
    min-width: 0;
  }

  .menu-bar {
    display: flex;
    align-items: center;
    align-self: flex-end;
    height: 27px;
    max-width: 100%;
    padding-inline: 10px;
    border-radius: 7px;
    background: rgba(28, 28, 32, 0.95);
    box-shadow: var(--shadow-product);
    color: #F5F5F7;
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
    font-size: 13px;
    white-space: nowrap;
  }

  .menu-bar span {
    padding-inline: 9px;
  }

  .menu-bar__warning {
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.22);
  }

  .failure-menu {
    width: min(296px, calc(100% - 52px));
    align-self: flex-end;
    margin-top: 5px;
    padding-block: 5px;
    border-radius: 10px;
    background: rgba(248, 248, 250, 0.99);
    box-shadow: 0 18px 44px rgba(43, 42, 40, 0.28), 0 0 0 1px rgba(0, 0, 0, 0.09);
    color: #1D1D1F;
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
    font-size: 13px;
  }

  .failure-menu__row {
    padding: 4px 14px;
  }

  .failure-menu__row--strong {
    padding-bottom: 1px;
    font-weight: 600;
  }

  .failure-menu__row--between {
    display: flex;
    justify-content: space-between;
  }

  .failure-menu__error {
    overflow: hidden;
    padding: 1px 14px 4px;
    color: #6E6E73;
    font-family: 'SF Mono', ui-monospace, monospace;
    font-size: 11px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .menu-rule {
    height: 1px;
    margin: 4px 14px;
    background: rgba(0, 0, 0, 0.1);
  }

  .config-disclosure {
    min-width: 0;
  }

  .config-disclosure > summary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: var(--space-2);
    padding: 10px var(--space-3);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-button);
    background: var(--color-paper-raised);
    color: var(--color-link-readable);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    list-style: none;
    margin-top: var(--space-3);
    user-select: none;
  }

  .config-disclosure > summary::-webkit-details-marker {
    display: none;
  }

  .config-disclosure > summary::marker {
    content: '';
  }

  .config-disclosure > summary:hover {
    background: var(--color-paper-field);
    color: var(--color-link);
  }

  .config-disclosure > summary:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  .config-disclosure[open] > summary {
    background: var(--color-ink);
    color: var(--color-dark-copy);
  }

  .config-disclosure[open] .config-disclosure__indicator {
    transform: rotate(45deg);
  }

  .config-disclosure__indicator {
    font-size: 16px;
    line-height: 1;
  }

  .config-panel {
    width: min(520px, 100%);
    margin-top: var(--space-3);
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-panel);
    background: var(--color-ink);
    color: var(--color-dark-copy);
  }

  .config-panel pre {
    max-width: 100%;
    max-height: min(60vh, 360px);
    margin: 0;
    padding: var(--space-4);
    overflow: auto;
    color: var(--color-dark-copy);
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.85;
    white-space: pre;
  }

  .config-panel pre:focus-visible {
    outline: 2px solid var(--color-dark-prompt);
    outline-offset: -4px;
  }

  figcaption {
    margin-top: 22px;
    color: var(--color-meta-readable);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
    text-align: right;
  }

  .product-figure--compact .menu-bar {
    align-self: flex-start;
    font-size: 12.5px;
  }

  .product-figure--compact .failure-menu {
    display: none;
  }

  .product-figure--compact .config-disclosure {
    display: none;
  }

  @media (max-width: 720px) {
    .menu-bar {
      align-self: stretch;
      justify-content: center;
      overflow: hidden;
      font-size: 12px;
    }

    .menu-bar span {
      padding-inline: 5px;
    }

    .failure-menu {
      width: min(296px, calc(100% - 20px));
    }

    .config-panel {
      width: 100%;
    }
  }
</style>
