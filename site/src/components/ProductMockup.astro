---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<figure class:list={['product-figure', { 'product-figure--compact': compact }]}>
  <div class="menu-bar" role="group" aria-label="Example menu bar with a failed deploy item">
    <span>disk 82%</span>
    <span>vpn up</span>
    <span class="menu-bar__warning">deploy ⚠︎</span>
    <span>14:32</span>
  </div>
  <div class="failure-menu" role="group" aria-label="Example pinchos failure menu">
    <div class="failure-menu__row">Run Deploy Check</div>
    <div class="failure-menu__row">Refresh Now</div>
    <div class="menu-rule"></div>
    <div class="failure-menu__row failure-menu__row--strong">Failed 2 minutes ago — exit 1</div>
    <div class="failure-menu__error">jq: parse error: Invalid numeric literal</div>
    <div class="failure-menu__row">Copy Full Error</div>
    <div class="menu-rule"></div>
    <div class="failure-menu__row failure-menu__row--between"><span>Diagnostics</span><span>▸</span></div>
  </div>
  {!compact && <figcaption>a failing item promotes its cause to the first level — one glance, one Copy Full Error.</figcaption>}
</figure>

<style>
  .product-figure {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    margin: 0;
  }

  .menu-bar {
    display: flex;
    align-items: center;
    align-self: flex-end;
    height: 27px;
    max-width: 100%;
    padding-inline: 10px;
    border-radius: 7px;
    background: rgba(28, 28, 32, 0.95);
    box-shadow: var(--shadow-product);
    color: #F5F5F7;
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
    font-size: 13px;
    white-space: nowrap;
  }

  .menu-bar span {
    padding-inline: 9px;
  }

  .menu-bar__warning {
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.22);
  }

  .failure-menu {
    width: min(296px, calc(100% - 52px));
    align-self: flex-end;
    margin-top: 5px;
    padding-block: 5px;
    border-radius: 10px;
    background: rgba(248, 248, 250, 0.99);
    box-shadow: 0 18px 44px rgba(43, 42, 40, 0.28), 0 0 0 1px rgba(0, 0, 0, 0.09);
    color: #1D1D1F;
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
    font-size: 13px;
  }

  .failure-menu__row {
    padding: 4px 14px;
  }

  .failure-menu__row--strong {
    padding-bottom: 1px;
    font-weight: 600;
  }

  .failure-menu__row--between {
    display: flex;
    justify-content: space-between;
  }

  .failure-menu__error {
    overflow: hidden;
    padding: 1px 14px 4px;
    color: #6E6E73;
    font-family: 'SF Mono', ui-monospace, monospace;
    font-size: 11px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .menu-rule {
    height: 1px;
    margin: 4px 14px;
    background: rgba(0, 0, 0, 0.1);
  }

  figcaption {
    margin-top: 22px;
    color: var(--color-meta-readable);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
    text-align: right;
  }

  .product-figure--compact .menu-bar {
    align-self: flex-start;
    font-size: 12.5px;
  }

  .product-figure--compact .failure-menu {
    display: none;
  }

  @media (max-width: 720px) {
    .menu-bar {
      align-self: stretch;
      justify-content: center;
      overflow: hidden;
      font-size: 12px;
    }

    .menu-bar span {
      padding-inline: 5px;
    }

    .failure-menu {
      width: min(296px, calc(100% - 20px));
    }
  }
</style>
