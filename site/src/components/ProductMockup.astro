---
import InteractiveMenuBar from './InteractiveMenuBar.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<figure class:list={['product-figure', { 'product-figure--compact': compact }]}>
  <div class="product-visual">
    <InteractiveMenuBar compact={compact} />
  </div>
  {!compact && (
    <figcaption>
      the preview follows the canonical 0.1 config: static, cached, action, run-plus-action, and separator rows; opening the menu never runs a command.
    </figcaption>
  )}
</figure>

<style>
  .product-figure {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    margin: 0;
  }

  .product-visual {
    min-width: 0;
  }

  figcaption {
    margin-top: var(--mockup-menu-caption-margin);
    color: var(--color-meta-readable);
    font-family: var(--font-mono);
    font-size: var(--mockup-menu-small-size);
    line-height: var(--mockup-menu-caption-line-height);
    text-align: right;
  }

</style>
