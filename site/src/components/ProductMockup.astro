---
import sampleConfig from '../../../example/pinchos.toml?raw';
import InteractiveMenuBar from './InteractiveMenuBar.astro';

interface Props {
  compact?: boolean;
  interactive?: boolean;
}

const { compact = false, interactive = false } = Astro.props;
---

<figure class:list={['product-figure', { 'product-figure--compact': compact }]}>
  <div class="product-visual">
    {interactive ? (
      <InteractiveMenuBar />
    ) : (
      <>
        <div class="menu-bar" role="group" aria-label="Example menu bar with a failed deploy item">
          <span>disk 82%</span>
          <span>vpn up</span>
          <span class="menu-bar__warning">deploy ⚠︎</span>
          <span>14:32</span>
        </div>
        <div class="failure-menu" role="group" aria-label="Example pinchos failure menu">
          <div class="failure-menu__row">Run Deploy Check</div>
          <div class="failure-menu__row">Refresh Now</div>
          <div class="menu-rule"></div>
          <div class="failure-menu__row failure-menu__row--strong">Failed 2 minutes ago — exit 1</div>
          <div class="failure-menu__error">jq: parse error: Invalid numeric literal</div>
          <div class="failure-menu__row">Copy Full Error</div>
          <div class="menu-rule"></div>
          <div class="failure-menu__row failure-menu__row--between"><span>Diagnostics</span><span>▸</span></div>
        </div>
      </>
    )}
    {!compact && (
      <details class="config-disclosure">
        <summary aria-controls="sample-pinchos-config">
          <span class="config-disclosure__label config-disclosure__label--closed">See config</span>
          <span class="config-disclosure__label config-disclosure__label--open">Hide config</span>
          <span class="config-disclosure__indicator" aria-hidden="true">+</span>
        </summary>
        <div class="config-panel" id="sample-pinchos-config" role="region" aria-label="Sample pinchos.toml configuration">
          <pre tabindex="0"><code data-sample-config>{sampleConfig}</code></pre>
        </div>
      </details>
    )}
  </div>
  {!compact && (
    <figcaption>
      {interactive
        ? 'click an item to open its submenu; choose Hide to preview hidden = true in the TOML, set hidden = false to restore it; choose Collapse Pinchos to try the one-icon nested menu; Option-click to reveal diagnostics.'
        : 'a failing item promotes its cause to the first level — one glance, one Copy Full Error.'}
    </figcaption>
  )}
</figure>

<style>
  .product-figure {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    margin: 0;
  }

  .product-visual {
    min-width: 0;
  }

  .menu-bar {
    display: flex;
    align-items: center;
    align-self: flex-end;
    height: var(--mockup-menu-bar-height);
    max-width: 100%;
    padding-inline: var(--mockup-menu-static-bar-padding);
    border-radius: var(--mockup-menu-bar-radius);
    background: var(--mockup-menu-static-bar-background);
    box-shadow: var(--shadow-product);
    color: var(--mockup-menu-static-bar-foreground);
    font-family: var(--mockup-menu-font);
    font-size: var(--mockup-menu-size);
    white-space: nowrap;
  }

  .menu-bar span {
    padding-inline: var(--mockup-menu-static-item-padding);
  }

  .menu-bar__warning {
    border-radius: var(--mockup-menu-chip-radius);
    background: var(--mockup-menu-static-warning-background);
  }

  .failure-menu {
    width: min(var(--mockup-menu-static-panel-width), calc(100% - var(--mockup-menu-static-panel-inset)));
    align-self: flex-end;
    margin-top: var(--mockup-menu-static-panel-margin);
    padding-block: var(--mockup-menu-static-panel-padding);
    border-radius: var(--mockup-menu-panel-radius);
    background: var(--mockup-menu-static-panel-background);
    box-shadow: var(--mockup-menu-static-shadow);
    color: var(--mockup-menu-static-panel-foreground);
    font-family: var(--mockup-menu-font);
    font-size: var(--mockup-menu-size);
  }

  .failure-menu__row {
    padding: var(--mockup-menu-static-row-padding) var(--mockup-menu-item-padding);
  }

  .failure-menu__row--strong {
    padding-bottom: var(--mockup-menu-rule-height);
    font-weight: 600;
  }

  .failure-menu__row--between {
    display: flex;
    justify-content: space-between;
  }

  .failure-menu__error {
    overflow: hidden;
    padding: var(--mockup-menu-rule-height) var(--mockup-menu-item-padding) var(--mockup-menu-static-row-padding);
    color: var(--mockup-menu-static-muted);
    font-family: var(--mockup-menu-mono-font);
    font-size: var(--mockup-menu-small-size);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .menu-rule {
    height: var(--mockup-menu-rule-height);
    margin: var(--mockup-menu-static-row-padding) var(--mockup-menu-item-padding);
    background: var(--mockup-menu-static-rule);
  }

  .config-disclosure {
    min-width: 0;
  }

  .config-disclosure > summary {
    display: inline-flex;
    min-height: var(--mockup-menu-row-height);
    align-items: center;
    gap: var(--space-2);
    padding: var(--mockup-menu-config-padding) var(--space-3);
    border: var(--mockup-menu-border-width) solid var(--color-ink);
    border-radius: var(--radius-button);
    background: var(--color-paper-raised);
    color: var(--color-link-readable);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--mockup-menu-mobile-size);
    font-weight: 500;
    list-style: none;
    margin-top: var(--space-3);
    user-select: none;
  }

  .config-disclosure > summary::-webkit-details-marker {
    display: none;
  }

  .config-disclosure > summary::marker {
    content: '';
  }

  .config-disclosure > summary:hover {
    background: var(--color-paper-field);
    color: var(--color-link);
  }

  .config-disclosure > summary:focus-visible {
    outline: var(--mockup-menu-focus-width) solid var(--color-link);
    outline-offset: var(--mockup-menu-focus-offset);
  }

  .config-disclosure[open] > summary {
    background: var(--color-ink);
    color: var(--color-dark-copy);
  }

  .config-disclosure[open] .config-disclosure__indicator {
    transform: rotate(45deg);
  }

  .config-disclosure__indicator {
    font-size: var(--mockup-menu-indicator-size);
    line-height: 1;
  }

  .config-disclosure__label--open {
    display: none;
  }

  .config-disclosure[open] .config-disclosure__label--closed {
    display: none;
  }

  .config-disclosure[open] .config-disclosure__label--open {
    display: inline;
  }

  .config-panel {
    width: min(var(--mockup-menu-config-width), 100%);
    margin-top: var(--space-3);
    overflow: hidden;
    border: var(--mockup-menu-border-width) solid var(--color-rule);
    border-radius: var(--radius-panel);
    background: var(--color-ink);
    color: var(--color-dark-copy);
  }

  .config-panel pre {
    max-width: 100%;
    max-height: min(60vh, var(--mockup-menu-config-height));
    margin: 0;
    padding: var(--space-4);
    overflow: auto;
    color: var(--color-dark-copy);
    font-family: var(--font-mono);
    font-size: var(--mockup-menu-config-size);
    line-height: var(--mockup-menu-code-line-height);
    white-space: pre;
  }

  .config-panel pre:focus-visible {
    outline: var(--mockup-menu-focus-width) solid var(--color-dark-prompt);
    outline-offset: var(--mockup-menu-focus-inset);
  }

  figcaption {
    margin-top: var(--mockup-menu-caption-margin);
    color: var(--color-meta-readable);
    font-family: var(--font-mono);
    font-size: var(--mockup-menu-small-size);
    line-height: var(--mockup-menu-caption-line-height);
    text-align: right;
  }

  .product-figure--compact .menu-bar {
    align-self: flex-start;
    font-size: var(--mockup-menu-compact-size);
  }

  .product-figure--compact .failure-menu {
    display: none;
  }

  .product-figure--compact .config-disclosure {
    display: none;
  }

  @media (max-width: 720px) {
    .menu-bar {
      align-self: stretch;
      justify-content: center;
      overflow: hidden;
      font-size: var(--mockup-menu-mobile-size);
    }

    .menu-bar span {
      padding-inline: var(--mockup-menu-mobile-item-padding);
    }

    .failure-menu {
      width: min(var(--mockup-menu-static-panel-width), calc(100% - var(--mockup-menu-mobile-panel-inset)));
    }

    .config-panel {
      width: 100%;
    }
  }
</style>
