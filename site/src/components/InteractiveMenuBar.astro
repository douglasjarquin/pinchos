---
import sampleConfig from '../../../example/pinchos.toml?raw';
import '../styles/interactive-menu-bar.css';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class="interactive-menu" data-interactive-menu>
  <p class="interactive-menu__description" id="interactive-menu-description">
    Static preview of the canonical Pinchos 0.1 configuration. <code>init</code> writes this <code>/bin/date</code> clock item so a fresh Mac gets a working menu.
  </p>
  <details class="menu-disclosure">
    <summary class="menu-bar" aria-label="Open the clock menu">
      <span>clock</span>
      <span>14:07</span>
    </summary>
    {!compact && <div class="example-menu" role="group" aria-label="Clock submenu">
      <div class="example-menu__row-set" role="none">
        <div class="example-menu__row">The default item has no extra menu rows.</div>
      </div>
    </div>}
  </details>
  {!compact && <details class="config-disclosure">
    <summary>See canonical config</summary>
    <pre tabindex="0"><code>{sampleConfig}</code></pre>
  </details>}
</div>
